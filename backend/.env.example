DATABASE_URL=postgresql://user:password@localhost:5433/agrisense
OPENAI_API_KEY=your-openai-api-key-here
# ^ also used by app/tools/voice.py for Whisper speech-to-text (voice_input node)
CROP_HEALTH_API_KEY=your-kindwise-crop-health-api-key-here
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# BDApps TAP API — application credentials issued when provisioning the app
# in the BDApps portal, and the SMS shortcode registered as its sourceAddress.
BDAPPS_APPLICATION_ID=
BDAPPS_PASSWORD=
BDAPPS_BASE_URL=https://developer.bdapps.com
BDAPPS_SMS_SOURCE_ADDRESS=
BDAPPS_API_VERSION=1.0
# Optional: a static-outbound-IP HTTP proxy (e.g. Render's Fixie add-on),
# needed because BDApps requires calls to originate from a whitelisted IP,
# which Render's own dynamic outbound IP is not. Leave blank to call BDApps
# directly.
FIXIE_URL=
